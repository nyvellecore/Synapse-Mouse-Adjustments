<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Version>1.1.0</Version>
    <Product>Synapse Mouse Adjustments</Product>
    <Company>Synapse Mouse Adjustments</Company>
    <Copyright>Copyright © 2026 Synapse Mouse Adjustments contributors</Copyright>
    <!-- Lets the Windows-only WPF project be compiled (not run) on Linux/macOS CI as well. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
